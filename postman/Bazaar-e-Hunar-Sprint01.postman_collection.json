{
  "info": {
    "name": "Bazaar-e-Hunar Sprint 0 + 1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Register Buyer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ayesha Asif\",\n  \"email\": \"buyer@example.com\",\n  \"password\": \"secret123\",\n  \"role\": \"BUYER\"\n}"
        },
        "url": "{{baseUrl}}/auth/register"
      }
    },
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json.token) pm.collectionVariables.set('token', json.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"buyer@example.com\",\n  \"password\": \"secret123\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "My Profile",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/users/me"
      }
    },
    {
      "name": "Buyer Dashboard Allowed",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/dashboard/buyer"
      }
    },
    {
      "name": "Admin Dashboard Blocked For Buyer",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/dashboard/admin"
      }
    },
    {
      "name": "Marketplace Catalog",
      "item": [
        {
          "name": "List Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ]
            }
          }
        },
        {
          "name": "Category Tree",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/categories/tree",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "categories",
                "tree"
              ]
            }
          }
        },
        {
          "name": "Ustad Karim Artisan",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/artisans/ustad-karim",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "artisans",
                "ustad-karim"
              ]
            }
          }
        },
        {
          "name": "Sprint 2 Pattern Demo",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/patterns/sprint2-demo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "patterns",
                "sprint2-demo"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Cart Patterns",
      "item": [
        {
          "name": "Cart Pricing Preview",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"subtotal\":10000,\"coupon\":\"HUNAR10\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/cart/preview",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cart",
                "preview"
              ]
            }
          }
        },
        {
          "name": "Cart Pattern Demo",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/patterns/cart-demo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "patterns",
                "cart-demo"
              ]
            }
          }
        }
      ]
    }
  ]
}